// Buckler forward smash, hit 1. Attack pressed on frames 23-36 (move frames 22-35) starts hit 2 (29 = ext1), which keeps this hit's
// charge (its `keep_charge`). A press up to 9 frames before the window (the input buffer) waits for it.
var pressed;
if attack_tap && frame >= 13 { pressed = 1; }
if pressed && frame >= 22 && frame <= 35 { goto(29); }
