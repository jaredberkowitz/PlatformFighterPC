// Bracers down special on the ground (the reference's hand slap), the start and the first loop (frames 1-34). Special pressed again
// at any point banks one more loop; pressed in the loop's frames 20-26 (here 28-34: move frames 27-33) it banks two (the reference's
// quirk). On the reference's frame 35 the move goes on to another loop (35 = ext7) if one is banked, else to the ending (36 = ext8).
var more;
if special_tap {
    if frame >= 27 { more = max(more, 2); } else { more = max(more, 1); }
}
if frame >= 34 {
    if more > 0 { more = more - 1; goto(35); } else { goto(36); }
}
