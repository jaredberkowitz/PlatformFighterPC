// Dagger side special, the curse bolt: on move frame 15 (the reference's 16) the bolt leaves, straight ahead on the ground and 30
// degrees down from the air, 1.6 of the reference's units a frame (0.2 world) [E].
if frame == 15 {
    if grounded {
        spawn(0.75, 0.875, 0.2, 0);
    } else {
        spawn(0.75, 0.875, 0.173, -0.1);
    }
}
