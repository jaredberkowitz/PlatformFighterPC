// Up special (the reference's parameters, in world units: reference / 8). In the air the startup keeps 0.67 of the horizontal
// speed and stops the fall, then sinks at 0.02 with friction 0.01. The stick on frame 16 aims the dash (neutral: straight up;
// backward turns the brawler round; on the ground it cannot aim below level). The dash is frames 26-32: 3.8 a frame, less 0.2 a
// frame after its first 4. Touching down while dashing more than 20 degrees below level bounces off (30 = ext2); less, it carries on
// along the ground. Frame 33 keeps 0.7 of the speed on the ground, 0.8 in the air, and the move goes on as its ending: on the ground
// (28 = ext0) or in the air (29 = ext1), with the ending's friction and gravity.
var dx;
var dy;
if frame == 1 && grounded == 0 { set_vel(vx * 0.67, 0); }
if frame >= 2 && frame <= 24 && grounded == 0 {
    set_vel(sign(vx) * max(abs(vx) - 0.00125, 0), vy - 0.0025);
}
if frame == 15 {
    let sx = stick_x;
    let sy = stick_y;
    if grounded && sy < 0 { sy = 0; }
    let len = sqrt(sx * sx + sy * sy);
    if len < 0.25 {
        dx = 0;
        dy = 1;
    } else {
        if sx < 0 { turn(); sx = -sx; }
        dx = sx / len;
        dy = sy / len;
    }
}
if frame >= 25 && frame <= 31 {
    if grounded && dy < -0.342 { goto(30); }
    let speed = 0.475;
    if frame > 28 { speed = 0.475 - 0.025 * (frame - 28); }
    set_vel(dx * speed, dy * speed);
}
if frame == 32 {
    if grounded { set_vel(vx * 0.7, 0); } else { set_vel(vx * 0.8, vy * 0.8); }
}
if frame == 33 {
    if grounded { goto(28); } else { goto(29); }
}
