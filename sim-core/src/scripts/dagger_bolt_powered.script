// Dagger side special with the partner (ext8, slot 36), the stronger bolt: on move frame 15 (the reference's 16) the bolt leaves, straight ahead on the ground and 30
// degrees down from the air, 3.0 of the reference's units a frame (0.375 world) [E].
if frame == 15 {
    if grounded {
        spawn(0.75, 0.875, 0.375, 0);
    } else {
        spawn(0.75, 0.875, 0.325, -0.1875);
    }
}
