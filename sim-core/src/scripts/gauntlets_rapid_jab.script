// Gauntlets rapid jab, first cycle (ext10, slot 39). The first cycle always plays out. At its loop point (frame 20) it loops on
// (40 = ext11, whose first frame is this cycle's frame 3) while attack is held or was pressed in the last 8 frames, else it ends in
// the finisher (41 = ext12). `seen` carries on from jab 2's first variable: the press count last looked at.
var seen;
var quiet;
if attack || presses > seen { quiet = 0; } else { quiet = quiet + 1; }
seen = presses;
if frame >= 19 {
    if quiet < 8 { goto(40); } else { goto(41); }
}
