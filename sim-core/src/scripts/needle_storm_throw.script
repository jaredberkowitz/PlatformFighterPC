// Needle Storm, the throw (ext4, slot 32): the charged needles, one every 3 frames from frame 11; straight ahead on the ground
// (1.25 units a frame), 35 degrees down from the air. In the air the move ends at frame 43 instead of 49.
var needles;
var thrown;
if thrown < needles && frame == 10 + 3 * thrown {
    thrown = thrown + 1;
    if grounded { spawn(1.0, 1.1, 1.25, 0); } else { spawn(1.25, 0.88, 1.02, -0.72); }
}
if grounded == 0 && frame >= 41 { end(); }
