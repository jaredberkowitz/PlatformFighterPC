// Down special, charging (ext1): a frame of charge each frame, 80 in all. Special shoots (30 = ext2); shield or jump keeps the charge
// for later and ends the move with no lag (so the shield, roll, air dodge or jump comes out at once). A full charge does not keep
// itself: the stance holds at full until special or shield (or jump), as the reference; the move restarts itself (29 = ext1) before
// its length runs out. Being hit loses what was being charged (it is only kept by `store`).
var c;
var quick;
var aim;
c = min(c + 1, 80);
if special_tap {
    goto(30);
} else if shield || jump {
    store(c);
    end();
} else if frame >= 90 {
    goto(29);
}
