        autocancel_after 35
        hitbox { start 15 end 16 x 0.4 y 0.2 radius 1.09999 damage 15 angle 270 bkb 6 kbg 90 }
        hitbox { start 15 end 16 x 0.5 y 0.7 radius 1.29999 damage 13 angle 270 bkb 6 kbg 90 priority 1 }
    }
    move neutral_special {
        total_frames 51
        hitbox { start 14 end 18 x 2.09999 y 1 radius 0.9 damage 7 angle 60 bkb 80 kbg 37 }
        projectile {
            frame 15
            x 2
            y 1.2
            speed 0.375
            life 35
            end_damage 6
            hitbox { start 0 end 0 x 0 y 0 radius 0.5 damage 8 angle 361 bkb 20 kbg 0 }
        }
    }
    move side_special {
        total_frames 53
        helpless_after true
        hitbox { start 18 end 27 x 1.2 y 1.09999 radius 1.09999 damage 3 angle 361 bkb 20 kbg 0 }
        hitbox { start 28 end 31 x 1.4 y 0.29999 radius 1.09999 damage 20 angle 270 bkb 70 kbg 90 group 1 }
        hitbox { start 28 end 31 x 1.5 y 0.9 radius 1.29999 damage 15 angle 290 bkb 60 kbg 90 priority 1 group 1 }
        script {
            // Side special (dash): the stick at the start of the dash aims it a little up or down.
            var rise;
            if frame == 17 {
                rise = 0;
                if stick_y > 0.4 { rise = 0.3; }
                if stick_y < -0.4 { rise = -0.3; }
            }
            if frame >= 18 && frame <= 27 { set_vel(0.6875, rise); }
            if frame == 28 { set_vel(0, 0); }
        }
    }
    move up_special {
        total_frames 53
        helpless_after true
        grabs_ledge true
        rehit_start 17
        rehit_every 3
        hitbox { start 17 end 17 x 0.9 y 1.29999 radius 1.29999 damage 4 angle 65 bkb 100 kbg 0 }
        hitbox { start 18 end 27 x 0.9 y 1.29999 radius 1.29999 damage 2.5 angle 65 bkb 100 kbg 0 }
        hitbox { start 28 end 30 x 0.9 y 1.29999 radius 1.4 damage 6 angle 45 bkb 60 kbg 136 }
        script {
            // Up special: the stick at the end of the wind-up aims the flight in any direction (up and a little forward
            // if it is neutral). Pushing backward turns Wolf around first. The flight ends with a last small push.
            var dx;
            var dy;
            if frame == 16 {
                let sx = stick_x;
                let sy = stick_y;
                let len = sqrt(sx * sx + sy * sy);
                if len < 0.4 {
                    dx = 0.42;
                    dy = 0.91;
                } else {
                    if sx < 0 { turn(); sx = -sx; }
                    dx = sx / len;
                    dy = sy / len;
                }
            }
            if frame >= 17 && frame <= 30 { set_vel(dx * 0.44, dy * 0.44); }
            if frame == 31 { set_vel(dx * 0.08, dy * 0.08); }
        }
    }
    move down_special {
        total_frames 29
        hitbox { start 8 end 11 x 1.4 y 1.09999 radius 1.5 damage 4 angle 65 bkb 60 kbg 85 }
        reflector { start 8 end 20 x 1.4 y 1.09999 radius 1.7 damage_percent 150 speed_percent 130 }
        script {
            // Down special: intangible on frames 5 to 8, before the reflector comes up.
            if frame == 4 { intangible(4); }
        }
    }
    move jab2 {
        total_frames 20
        next jab3
        next_window 12
        hitbox { start 3 end 4 x 1.09999 y 1.09999 radius 0.9 damage 2 angle 361 bkb 20 kbg 20 priority 1 }
        hitbox { start 3 end 4 x 1.9 y 1.09999 radius 0.9 damage 2 angle 361 bkb 25 kbg 25 }
    }
    move jab3 {
        total_frames 33
        hitbox { start 3 end 4 x 1.2 y 1.09999 radius 1 damage 4 angle 55 bkb 40 kbg 176 priority 1 }
        hitbox { start 3 end 4 x 2.09999 y 1.09999 radius 1 damage 4 angle 55 bkb 40 kbg 176 }
    }
    move grab {
        total_frames 28
        hitbox { start 6 end 7 x 1.7 y 1.09999 radius 1.09999 damage 0 angle 361 bkb 0 kbg 0 kind grab }
    }
    move dash_grab {
        total_frames 36
        hitbox { start 7 end 8 x 1.9 y 1.09999 radius 1.09999 damage 0 angle 361 bkb 0 kbg 0 kind grab }
    }
    move pummel {
        total_frames 20
        hitbox { start 3 end 3 x 1.29999 y 1.09999 radius 1 damage 1.29999 angle 361 bkb 0 kbg 0 kind pummel }
    }
    move fthrow {
        total_frames 31
        hitbox { start 10 end 10 x 1.29999 y 1.09999 radius 1 damage 9 angle 45 bkb 55 kbg 57 kind throw }
    }
    move bthrow {
        total_frames 46
        hitbox { start 23 end 23 x -1.29999 y 1.09999 radius 1 damage 11 angle 50 bkb 40 kbg 150 kind throw }
    }
    move uthrow {
        total_frames 44
        hitbox { start 26 end 26 x 1.29999 y 1.09999 radius 1 damage 7 angle 80 bkb 75 kbg 110 kind throw }
    }
    move dthrow {
        total_frames 39
        hitbox { start 25 end 25 x 1.29999 y 1.09999 radius 1 damage 8.5 angle 361 bkb 50 kbg 65 kind throw }
    }
    move ledge_attack {
        total_frames 54
        intangible 26
        hitbox { start 23 end 25 x 2.09999 y 0.59999 radius 1 damage 9 angle 45 bkb 90 kbg 20 }
        hitbox { start 23 end 25 x 1.2 y 0.59999 radius 1 damage 9 angle 45 bkb 90 kbg 20 }
    }
    move get_up_attack {
        total_frames 31
        intangible 10
        hitbox { start 9 end 12 x 1.07997 y 0.5 radius 0.98997 damage 7.69994 angle 361 bkb 40 kbg 85 }
        hitbox { start 14 end 17 x -1.07999 y 0.5 radius 0.98997 damage 7.69994 angle 361 bkb 40 kbg 85 group 1 }
    }
    move pivot_grab {
        total_frames 31
        hitbox { start 10 end 11 x 1.7 y 1.09999 radius 1.09999 damage 0 angle 361 bkb 0 kbg 0 kind grab }
    }
}

