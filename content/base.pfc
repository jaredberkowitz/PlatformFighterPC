    move ext1 {
        total_frames 98
        land_continue true
        script {
            // Down special, charging (ext1): a frame of charge each frame, 80 in all. Special shoots (30 = ext2); shield or jump keeps the charge
            // for later and ends the move with no lag (so the shield, roll, air dodge or jump comes out at once). A full charge does not keep
            // itself: the stance holds at full until special or shield (or jump), as the reference; the move restarts itself (29 = ext1) before
            // its length runs out. Being hit loses what was being charged (it is only kept by `store`).
            var c;
            var quick;
            var aim;
            c = min(c + 1, 80);
            if special_tap {
                goto(30);
            } else if shield || jump {
                store(c);
                end();
            } else if frame >= 90 {
                goto(29);
            }
        }
    }
    move ext2 {
        total_frames 48
        land_continue true
        projectile {
            frame 255
            x 1
            y 0.79999
            speed 0
            life 13
            end_damage 0
            gravity 0.02124
            max_fall 0.375
            hitbox { start 0 end 0 x 0 y 0 radius 0.5 damage 0 angle 55 bkb 0 kbg 100 fixed_kb 70 push true }
        }
        script {
            // Down special, the shot (ext2), as the reference: the charge (c of 80 frames) is spent at once and pushes the fighter back 0.02
            // reference units a frame per charge frame; seven pumps, one every 5 frames from frame 1, each 4.3 to 8.6 reference units a frame
            // (world units: reference / 8), 0.8 to 1.2 times the size and up to 55 more base knockback with the charge. The stick turns the
            // aim 1.9 degrees a frame, from 12 up to 62 degrees or down to -6.
            var c;
            var quick;
            var aim;
            if frame == 1 { add_vel(-0.0025 * c, 0); }
            if stick_y > 0.3 { aim = min(aim + 1.9, 62); }
            if stick_y < -0.3 { aim = max(aim - 1.9, -6); }
            if frame >= 1 && frame <= 31 && frame - 1 == floor((frame - 1) / 5) * 5 {
                let k = c / 80;
                let speed = (4.3 + 4.3 * k) / 8;
                spawn_scaled(1.0, 0.8, speed * cos(aim), speed * sin(aim), 55 * k, 80 + 40 * k);
            }
        }
    }
    move pivot_grab {
        total_frames 35
