        hitbox { start 12 end 12 x 1.5 y 1 radius 0.79999 damage 0.59999 angle 361 bkb 8 kbg 15 priority 1 hitlag 50 hitstun_add 2 sdi 40 shieldstun 900 }
        hitbox { start 14 end 14 x 1 y 1.29999 radius 0.29999 damage 0.59999 angle 361 bkb 8 kbg 15 hitlag 50 hitstun_add 2 sdi 40 shieldstun 900 }
        hitbox { start 14 end 14 x 1.9 y 1 radius 0.79999 damage 0.59999 angle 361 bkb 8 kbg 15 priority 1 hitlag 50 hitstun_add 2 sdi 40 shieldstun 900 }
