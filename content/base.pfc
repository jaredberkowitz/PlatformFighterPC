        hitbox { start 2 end 2 x 1.09999 y 0.9 radius 0.2 damage 3 angle 361 bkb 35 kbg 28 priority 1 hitlag 150 angle_type forward }
        hitbox { start 2 end 2 x 1.5 y 0.9 radius 0.29999 damage 3 angle 180 bkb 10 kbg 20 priority 2 hitlag 150 angle_type forward }
        script {
            // Clutch jab 1. Attack held (no new press) carries on into jab 2 (slot 17): from frame 6 once jab 1 has hit, from frame 16 if it has
            // not (the reference's two continuable rows: "held on hit" and "held without hitting"). A new press carries on from frame 6 through
            // the move's `next_from`, not this script.
            if attack && hit == 1 && frame >= 5 { goto(17); }
            if attack && frame == 15 { goto(17); }
        }
    }
