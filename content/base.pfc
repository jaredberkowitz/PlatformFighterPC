                set_vel(sign(vx) * max(abs(vx) - 0.0125, 0), 0);
            } else {
                set_vel(sign(vx) * max(abs(vx) - 0.005, 0), vy - 0.0125);
            }
        }
    }
    move ext2 {
        total_frames 21
        landing_lag 36
        helpless_after true
        fall_drift 65
        fall_landing_lag 36
        script {
            // Up special, bouncing off the ground (ext2): 0.4 of the horizontal speed and 3 up, then friction 0.16 and gravity: 0.2 (the
            // reference's numbers, in world units: reference / 8).
            if frame == 1 {
                set_vel(vx * 0.4, 0.375);
            } else {
                set_vel(sign(vx) * max(abs(vx) - 0.02, 0), vy - 0.025);
            }
        }
    }
    move pivot_grab {
        total_frames 38
        hitbox { start 8 end 9 x 1.7 y 1.09999 radius 1.09999 damage 0 angle 361 bkb 0 kbg 0 kind grab }
    }
}

