    move neutral_special {
        total_frames 120
        land_continue true
        script {
            // Popgun neutral special (the peanut popgun). Move frames 0-14 (the reference's 1-15) raise the gun. On move frame 15 (its 16) the
            // uncharged peanut leaves if special is no longer held; held, the gun charges, and on the first frame special is up the charge is the
            // frames held since 15 (78 a full charge, its frame 94) and the peanut leaves: faster and flatter with the charge, from 1.6 / 8 a frame
            // 35 degrees up to 3.6 / 8 at 8 degrees [E], 0.75 ahead and 0.875 up [E]; the move goes on as the shot (31 = ext3, which keeps the
            // charge). Still held on move frame 95 (the reference's 96) the move goes on as the misfire (32 = ext4), whose explosion is on its next
            // frame (the reference's 97). From move frame 13 (its 14) the shield cancels the charge.
            if frame >= 13 && shield {
                end();
            }
            if frame >= 15 {
                let c = min(frame - 15, 78);
                if special == 0 {
                    set_charge(c);
                    let s = 0.2 + 0.25 * c / 78;
                    let a = 35 - 27 * c / 78;
                    spawn(0.75, 0.875, s * cos(a), s * sin(a));
                    goto(31);
                } else if frame >= 95 {
                    goto(32);
                }
            }
        }
    }
    move side_special {
        total_frames 60
        land_continue true
        ledge_front_from 12
        air_drift 0
        fast_fall_from 255
        air_version ext9
        catch_move ext11
        ledge_falling_only true
        hitbox { start 17 end 35 x 0.59999 y 0.9 radius 0.5 damage 0 angle 361 bkb 0 kbg 0 kind grab command true }
        hitbox { start 17 end 35 x 0.5 y 0.29999 radius 0.5 damage 0 angle 361 bkb 0 kbg 0 priority 1 kind grab command true }
        script {
            // Popgun side special, the leap (ground and air). On move frame 12 (the reference's 13) the scamp flips forward: 2.2 of the reference's
            // units a frame ahead (2.8 for a smash input) and 1.7 up [E], then flies on its own gravity. From the launch to the end of the grab
            // (move frame 35), special pressed again is the kick (39 = ext10). (No variables: the latch it may go on as counts its own.)
            if frame == 12 {
                set_vel((2.2 + 0.6 * flick) / 8, 1.7 / 8);
            }
            if frame >= 13 && frame <= 35 && special_tap {
                goto(39);
            }
        }
    }
    move up_special {
        total_frames 80
        land_continue true
        start_speed 0
        start_speed_y 0
        air_gravity 0.00249
        air_max_fall 0.0625
        shed ext8
        flag_version { flags 2 }
        flag_version { marks 1 move ext5 }
        script {
            // Popgun up special (the rocket barrels), the charge. From move frame 6 (the reference's 7) special held charges it: the stick tilts
            // the launch angle `a` (degrees from straight up, positive forward) by up to 0.75 a frame, at most 45 either way [E]; let go, or after
            // 60 frames, the charge is the frames held and the move goes on as the flight (34 = ext6), launched on the next frame (the reference's
            // 8 to 68). Started in the air it marks the air time (mark 0: a hit does not clear it), so a later charge in it is the one on the
            // body's own fall (owner decision 75: only the first charge falls slowly; the up special's flag version reads the mark).
            var a;
            if frame == 1 && grounded == 0 {
                set_air_mark(0);
            }
            if frame >= 6 {
                a = clamp(a + stick_x * 0.75, -45, 45);
                if special == 0 || frame >= 66 {
                    set_charge(frame - 6);
                    goto(34);
                }
            }
        }
    }
    move down_special {
        total_frames 38
        land_continue true
        toss { frame 19 angle 105 speed 0.275 smash_speed 0.37949 wait 85 }
        pull_frame 3
        pull_item 0
        script {
            // Popgun down special (the banana peel). On the move's frame 1 (the first a script sees) it picks its version: with a peel (kind 9)
            // already out or the wait since the last toss not over, the toss that makes no peel (29 = ext1; 30 = ext2 with an item in the hand,
            // which is still tossed); else with an item in the hand, the version that tosses it first (28 = ext0); else the move goes on as it is.
            if frame == 1 {
                if owns(9) > 0 || pull_wait > 0 {
                    if holding > 0 {
                        goto(30);
                    } else {
                        goto(29);
                    }
                } else if holding > 0 {
                    goto(28);
                }
            }
        }
    }
