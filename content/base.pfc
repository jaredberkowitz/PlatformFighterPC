        hitbox { start 48 end 48 x 0.9 y 1.79999 radius 0.9 damage 4 angle 361 bkb 30 kbg 200 group 1 hitlag 200 clanks false rebounds false angle_type forward }
        air { from 0 to 46 gravity 0.00659 speed 0.05774 accel_stick 0.0275 }
        air { from 47 to 255 gravity 0.00659 speed 0.09999 accel_stick 0.00124 }
        script {
            // Buckler up special in the air (the rising spin): the rise starts at 2.4 of the reference's units a frame (0.3) on the first frame
            // the script runs [E: frame], keeping the horizontal speed; the spin hits share one hit group, re-armed just before each (reference
            // frames 12, 16, 19, 22, 26, 31 and 38).
            if frame == 1 { set_vel(vx, 0.3); }
            if frame == 11 || frame == 15 || frame == 18 || frame == 21 || frame == 25 || frame == 30 || frame == 37 { rehit(); }
        }
    }
    move ext1 {
        total_frames 59
        keep_charge true
        hitbox { start 9 end 10 x 2.29999 y 1.59999 radius 0.59999 damage 13 angle 48 bkb 85 kbg 89 hitlag 150 angle_type forward }
        hitbox { start 9 end 10 x 1.59999 y 1.4 radius 0.59999 damage 13 angle 48 bkb 85 kbg 89 priority 1 hitlag 150 angle_type forward }
        hitbox { start 9 end 10 x 0.5 y 1.29999 radius 0.4 damage 12 angle 48 bkb 85 kbg 89 priority 2 hitlag 150 angle_type forward }
        hitbox { start 9 end 10 x 0.4 y 1.09999 radius 0.4 damage 12 angle 48 bkb 85 kbg 89 priority 3 hitlag 150 clanks false rebounds false angle_type forward }
    }
    move ext2 {
        total_frames 78
        landing_lag 19
        hitbox { start 29 end 49 x 0.09999 y 0.09999 radius 0.5 damage 11 angle 65 bkb 50 kbg 80 hitlag 120 angle_type position }
        script {
            // Buckler down air after a bounce (ext2): the vertical speed is set to 1.33 of the reference's units [R] on its first frame that
            // moves; its box comes back on its frames 29 on (30 after the hit). Another hit when not fast falling bounces again. At the down
            // air's move frame 64 (just past the end of its box) it goes on as its last frames (31 = ext3).
            var start;
            if frame == 1 { set_vel(vx, 0.16625); }
            if hit && fast_fall == 0 { start = start + frame; goto(30); }
            if start + frame >= 64 { goto(31); }
        }
    }
    move ext3 {
