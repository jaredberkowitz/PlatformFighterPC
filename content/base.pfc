        hitbox { start 16 end 16 x 1.9 y 1 radius 0.79999 damage 0.59999 angle 361 bkb 8 kbg 15 priority 1 hitlag 50 hitstun_add 2 sdi 40 shieldstun 900 }
        hitbox { start 16 end 16 x 1.5 y 1 radius 0.79999 damage 0.59999 angle 361 bkb 8 kbg 15 priority 1 hitlag 50 hitstun_add 2 sdi 40 shieldstun 900 }
        script {
            // Gauntlets rapid jab, later cycles (ext11, slot 40; its frame 0 is the cycle's frame 3, so frame 17 is the loop point, frame 20).
            // After the first cycle, letting go of attack ends it in the finisher (41 = ext12) at any point: once attack has been neither held
            // nor pressed for 8 frames (so mashing keeps it going). Otherwise it loops at the loop point.
            var seen;
            var quiet;
            if attack || presses > seen { quiet = 0; } else { quiet = quiet + 1; }
            seen = presses;
            if quiet >= 8 { goto(41); }
            if frame >= 17 { goto(40); }
        }
    }
