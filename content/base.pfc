        hitbox { start 26 end 28 x 0 y 1 radius 0.59999 damage 2.5 angle 40 bkb 60 kbg 20 group 1 hitlag 50 targets grounded sdi 0 angle_type travel }
        hitbox {
            start 26
            end 28
            x 0
            y 1
            radius 0.79999
            damage 2.5
