        script {
            // Gauntlets down special, crashed into a wall: knocked back off it a little, then the rest of the 53-frame crash standing [E].
            if frame <= 6 { set_vel(-0.05, 0); }
            if frame > 6 { set_vel(0, 0); }
        }
    }
