    move neutral_special {
        total_frames 56
        charge_bonus 170
        hitbox { start 26 end 28 x 3.35193 y 1.17198 radius 0.79999 damage 9 angle 361 bkb 60 kbg 60 priority 2 shield_damage 200 }
        hitbox { start 26 end 28 x 2.34395 y 1.17198 radius 0.9 damage 8 angle 361 bkb 55 kbg 60 shield_damage 200 }
        motion { start 25 end 30 vx 0.45 vy 0 }
        script {
            // Neutral special (Shield Breaker): keep the special button down on frame 19 to charge, for as long as the
            // charge limit allows. The thrust comes out when the button is let go.
            if frame == 19 && special { stall(); }
        }
    }
    move side_special {
        total_frames 37
        hitbox { start 8 end 9 x 2.34395 y 1.09999 radius 0.7 damage 3 angle 361 bkb 25 kbg 0 priority 2 }
        hitbox { start 8 end 9 x 1.40796 y 1.09999 radius 0.79999 damage 2.5 angle 361 bkb 25 kbg 0 }
        script {
            // Side special (Dancing Blade), hit 1. Steps forward as it winds up (on the ground). Press special again before the
            // end to carry on into hit 2; holding the stick up makes the second hit the rising slash. Slot numbers: 29 = ext1,
            // 30 = ext2.
            var queued;
            var rising;
            if grounded == 0 && frame >= 27 { end(); }
            if grounded && frame >= 3 && frame <= 8 { set_vel(0.18, 0); }
            if grounded && frame == 9 { set_vel(0, 0); }
            if special_tap && frame >= 4 {
                queued = 1;
                rising = 0;
                if stick_y > 0.5 { rising = 1; }
            }
            if queued && frame >= 18 {
                queued = 0;
                if rising { goto(30); } else { goto(29); }
            }
        }
    }
