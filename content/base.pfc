    move fsmash {
        total_frames 49
        charge_at 8
        hitbox { start 16 end 17 x 1.9 y 1 radius 0.5 damage 7 angle 69 bkb 45 kbg 12 angle_type forward }
        hitbox { start 16 end 17 x 2.59999 y 0.7 radius 0.4 damage 14 angle 361 bkb 30 kbg 100 priority 1 angle_type forward }
        hitbox { start 16 end 17 x 0.79999 y 1.09999 radius 0.4 damage 7 angle 60 bkb 45 kbg 12 priority 2 angle_type forward }
        hitbox { start 16 end 17 x 0.4 y 1.09999 radius 0.4 damage 7 angle 60 bkb 45 kbg 12 priority 2 angle_type forward }
        projectile {
            frame 255
            x 1.375
            y 0.75
            speed 0.29999
            life 32
            end_damage 5
            drag 0.00124
            hitbox { start 0 end 0 x 0 y 0 radius 0.2 damage 5 angle 361 bkb 45 kbg 15 half_width 0.875 angle_type forward }
            charged { full 60 damage_to 13 speed_to 0.42499 life_to 40 size_from 80 size_to 110 }
        }
        script {
            // Buckler forward smash, hit 1. Attack pressed on frames 23-36 (move frames 22-35) starts hit 2 (29 = ext1), which keeps this hit's
            // charge (its `keep_charge`). A press from frame 14 on (the input buffer's 9 frames before the window) waits for it, hitlag included
            // (`presses` counts presses made in hitlag; the count at move frame 12 is the base). At exactly 0% the sword wave leaves with hit 1
            // on frame 17 (move frame 16), 11 ahead and 6 up of the reference's units, at the uncharged 2.4 (its spawn scales it by the charge).
            var seen;
            if frame == 12 { seen = presses; }
            if frame == 16 && percent == 0 { spawn(1.375, 0.75, 0.3, 0); }
            if frame >= 22 && frame <= 35 && presses > seen { goto(29); }
        }
    }
