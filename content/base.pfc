    move neutral_special {
        total_frames 200
        land_continue true
        script {
            // Buckler neutral special (the bow). Move frames 0-14 (the reference's 1-15) draw it; from move frame 15 (its 16) it holds while
            // special is held. On the first frame special is up, or after 180 held frames, the charge is the frames held, the arrow leaves 0.8
            // ahead and 1.2 up [E], 2.5 degrees above forward at the uncharged speed (2.6 / 8: the shot's spawn scales it by the charge, E35),
            // and the move goes on as the release (32 = ext4, which keeps the charge). With an arrow in hand (`holding` 3, the arrow item's kind:
            // E4) it is the double arrow instead (37 = ext9, which fires the arrow in hand three frames later).
            if frame >= 15 {
                let c = frame - 15;
                if special == 0 || c >= 180 {
                    set_charge(c);
                    spawn(0.8, 1.2, 0.325 * cos(2.5), 0.325 * sin(2.5));
                    if holding == 3 {
                        goto(37);
                    } else {
                        goto(32);
                    }
                }
            }
        }
    }
    move side_special {
        total_frames 44
        land_continue true
        smash_version ext5
        projectile {
            frame 255
            x 1
            y 1.09999
            speed 0.29999
            life 125
            end_damage 8
            bounce_max 4
            kind 1
            limit 1
            catch_from 45
            catch_move ext7
            bounces 255
            hitbox { start 0 end 0 x 0 y 0 radius 0.5 damage 8 angle 70 bkb 80 kbg 40 shield_damage 50 angle_type travel }
            phase {
                from 10
                hitbox { start 0 end 0 x 0 y 0 radius 0.5 damage 6 angle 65 bkb 60 kbg 40 shield_damage 50 angle_type travel }
            }
            phase {
                from 45
                hitbox { start 0 end 0 x 0 y 0 radius 0.5 damage 3 angle 70 bkb 50 kbg 40 shield_damage 50 angle_type travel }
            }
            on_clank { life 60 vx -0.01874 vy 0.15625 gravity 0.01125 max_fall 0.17499 }
        }
        script {
            // Buckler side special, the tilt throw (the smash input's is `buckler_boomerang_far.script`). With its boomerang already out
            // (`owned`) it goes on as the failed throw (34 = ext6) on its frame 2. On frame 27 (move frame 26) the boomerang leaves 1.0 ahead and
            // 1.1 up [E], aimed by the stick up to 26 degrees up or down in proportion, straight within 0.1 of the centre [E], at 2.4 (0.3 a frame).
            if frame == 1 && owned > 0 { goto(34); }
            if frame == 26 {
                let a = 0;
                if abs(stick_y) > 0.1 { a = 26 * stick_y; }
                spawn(1.0, 1.1, 0.3 * cos(a), 0.3 * sin(a));
            }
        }
        projectile_script {
            // The tilt boomerang's flight (world units: reference / 8). Out, it slows 0.047 a frame (0.005875) along its throw down to 0.3
            // (0.0375). Then it turns to face its thrower's middle (1.1 above the feet [E]) and speeds up by 0.0348 a frame, the rate that takes
            // it from 0.3 to 3 over the reference's "distance spent turning back" of 16 [E: gap 6, the reading], to 3 (0.375); after the turn it
            // steers toward its thrower by at most 0.75 degrees a frame [R].
            var back;
            let s = sqrt(pvx * pvx + pvy * pvy);
            if back == 0 && s > 0 {
                let ns = max(s - 0.005875, 0.0375);
                if ns <= 0.0375 { back = 1; }
                set_vel(pvx * ns / s, pvy * ns / s);
            } else if s > 0 {
                let tx = owner_x - px;
                let ty = owner_y + 1.1 - py;
                let d = sqrt(tx * tx + ty * ty);
                if d > 0.01 {
                    tx = tx / d;
                    ty = ty / d;
                    let ux = pvx / s;
                    let uy = pvy / s;
                    if back == 1 || ux * tx + uy * ty >= cos(0.75) {
                        back = 2;
                        ux = tx;
                        uy = ty;
                    } else {
                        let k = 0.75;
                        if ux * ty - uy * tx < 0 { k = -0.75; }
                        d = ux * cos(k) - uy * sin(k);
                        uy = ux * sin(k) + uy * cos(k);
                        ux = d;
                    }
                    d = min(s + 0.0348, 0.375);
                    set_vel(ux * d, uy * d);
                }
            }
        }
    }
