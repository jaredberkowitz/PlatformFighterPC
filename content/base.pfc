    move neutral_special {
        total_frames 49
        intangible 23
        land_continue true
        intangible_from 4
        pocket { start 7 end 22 x 1.125 y 0.875 radius 0.75 }
        script {
            // Settler neutral special (the pocket, E42). With a projectile in the pocket, or an item and an empty hand, the press takes it out:
            // on the move's frame 1 (the first a script sees) it goes on as the release (37 = ext9). Otherwise it is the reach (a held item is
            // put away in its place, swapping with an item already there).
            if frame == 1 && (pocketed == 1 || (pocketed == 2 && holding == 0)) {
                goto(37);
            }
        }
    }
    move side_special {
        total_frames 34
        land_continue true
        start_speed 0
        start_speed_y 0
        projectile {
            frame 19
            x 1.25
            y 0.5
            speed 0.00002
            life 157
            end_damage 0
            kind 4
            limit 1
            pocket frees
            hitbox { start 0 end 0 x 0 y 0 radius 0 damage 7 angle 60 bkb 65 kbg 75 shield_damage 50 hitlag 80 angle_type forward }
            phase {
                from 32
                hitbox { start 0 end 0 x 0 y 0 radius 0.4 damage 7 angle 60 bkb 65 kbg 75 shield_damage 50 hitlag 80 angle_type forward }
            }
            phase {
                from 97
                hitbox { start 0 end 0 x 0 y 0 radius 0.4 damage 5 angle 55 bkb 60 kbg 75 shield_damage 50 hitlag 80 angle_type forward }
            }
            burst {
                life 4
                on_wall true
                on_expire true
                on_hit false
                phase {
                    from 1
                    hitbox { start 0 end 0 x 0 y 0 radius 0.9 damage 12 angle 68 bkb 65 kbg 90 shield_damage 50 hitlag 80 clanks false rebounds false angle_type forward }
                }
            }
        }
        script {
            // The rocket (side special): special still held on frame 15 (the reference's 16) rides it (ext4, slot 32) [E: the frame], unless a
            // rocket is already out (then the move does nothing, as the reference's).
            if special && frame == 15 && owned == 0 { goto(32); }
        }
        projectile_script {
            // The rocket's flight (world units: the reference's / 8) [E: unpublished]. `a` is the age this frame's movement makes (the projectile's
            // age before it moves, plus one). Still until age 32 (the reference's frame 52), then 1.7 a frame (0.2125) to age 96; then slowing by
            // 1.7 / 60 a frame (0.003542) while dropping under 0.04 (0.005) to at most 1.0 (0.125). A sliver of speed keeps its direction.
            var dir;
            if dir == 0 { dir = sign(pvx); }
            let a = age + 1;
            if a < 32 {
                set_vel(dir * 0.0001, 0);
            } else if a < 97 {
                set_vel(dir * 0.2125, 0);
            } else {
                set_vel(dir * max(abs(pvx) - 0.003542, 0.0001), max(pvy - 0.005, -0.125));
            }
        }
    }
    move up_special {
        total_frames 250
        landing_lag 20
        helpless_after true
        ledge_front_from 2
        ledge_back_from 2
        fall_landing_lag 30
        fast_fall_from 255
        air_gravity 0.00749
        air_max_fall 0.125
        air_max_rise 0.17499
        balloons { count 2 hp 0.09999 x 0 y 3 radius 0.54999 fuel 300 refill 6 one_below 150 pop_vy 0.125 }
        script {
            // The balloon flight (up special) [E: every number]. Take-off: 1.6 of the reference's units a frame up (0.2) for 3 frames. Special
            // pressed flaps at once once 6 frames have passed since the last flap; held, every 12. A flap sets the rising speed to 1.4 (0.175) on
            // two balloons, 0.9 (0.1125) on one. Attack lets the balloons go (the special fall). Every 248 frames the flight goes on as ext8 (36).
            var since;
            since = since + 1;
            if frame < 3 {
                set_vel(vx, 0.2);
                since = 0;
            } else if attack_tap {
                end();
            } else if (special_tap && since >= 6) || (special && since >= 12) {
                since = 0;
                let lift = 0.1125;
                if balloons >= 2 { lift = 0.175; }
                add_vel(0, lift - vy);
            }
            if frame >= 247 { goto(36); }
        }
    }
    move down_special {
        total_frames 37
        land_continue true
        script {
            // Settler down special (the tree, E43). On the move's frame 1 (the first a script sees) it goes on as its stage, by what the settler
            // has out: its tree, standing (kind 6) or falling (kind 7), the axe (41 = ext12); its sapling (kind 5), the watering can (40 = ext11);
            // nothing, the planting on the ground (39 = ext10) or the planting that fails in the air (42 = ext13).
            if frame == 1 {
                if owns(6) + owns(7) > 0 {
                    goto(41);
                } else if owns(5) > 0 {
                    goto(40);
                } else if grounded {
                    goto(39);
                } else {
                    goto(42);
                }
            }
        }
    }
