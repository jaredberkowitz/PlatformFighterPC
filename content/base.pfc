stage proving_grounds {
    backdrop meadow
    blast_left -28
    blast_right 28
    blast_bottom -17
    blast_top 24
    platform { left -11 right 11 y 0 bottom -8 pass_through false }
    platform { left -8 right -3 y 3.59999 bottom 3.59999 pass_through true }
    platform { left 3 right 8 y 3.59999 bottom 3.59999 pass_through true }
    ledge { x -11 y 0 side -1 }
    ledge { x 11 y 0 side 1 }
    spawn { x -4 y 0 }
    spawn { x -1 y 0 }
    spawn { x 1 y 0 }
    spawn { x 4 y 0 }
}
