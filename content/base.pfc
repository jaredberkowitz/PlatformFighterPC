            // x0.2 on startup [R]; read on the move's first frame the script sees [D]). The wave itself is the move's projectile (its frame 16).
            if frame == 1 { set_vel(vx * 0.2, 0); }
        }
    }
    move side_special {
        total_frames 39
        limit_version ext8
        hitbox { start 9 end 10 x 2.4 y 1.5 radius 0.59999 damage 4 angle 75 bkb 30 kbg 35 angle_type forward }
        hitbox { start 9 end 10 x 1.59999 y 1.29999 radius 0.59999 damage 4 angle 112 bkb 32 kbg 40 priority 1 angle_type forward }
        hitbox { start 9 end 10 x 0.9 y 1.09999 radius 0.5 damage 4 angle 366 bkb 32 kbg 40 priority 2 angle_type forward }
        script {
            // Greatsword side special, slash 1 (the combo slash). On the ground it steps forward as it winds up [E: the reference's step is not
            // published]. Special pressed at any point of it (kept in a var) carries on into slash 2 (29 = ext1), but only once this slash has
            // connected, a shield included (the hit register), from frame 10 on (move frame 9) [R: UFD]; a whiff never carries on.
            var asked;
            if grounded && frame >= 3 && frame <= 8 { set_vel(0.12, 0); }
            if grounded && frame == 9 { set_vel(0, 0); }
            if special_tap { asked = 1; }
            if asked && hit && frame >= 9 { goto(29); }
        }
    }
