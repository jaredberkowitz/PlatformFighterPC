    move down_special {
        total_frames 38
        land_continue true
        pull_frame 16
        pull_item 0
        script {
            // Buckler down special (the bomb). With one of the wanderer's bombs out (in his hand, lying, flying or held by someone else: `owned`
            // counts the bombs he made), the press is the detonation: on the move's frame 1 (the first a script sees) every one no other fighter
            // holds is set to burst 11 frames later, 12 after the press (`detonate()`), and the move goes on as the detonation (36 = ext8, FAF 39
            // from here). Otherwise it is the pull: the bomb appears in the hand on move frame 16 (the move's `pull`), unless the hand already holds
            // an item.
            if frame == 1 && owned > 0 {
                detonate();
                goto(36);
            }
        }
    }
