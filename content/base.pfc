    move ext4 {
        total_frames 165
        helpless_after true
        land_continue true
        hitbox { start 36 end 100 x 0.5 y 0.29999 radius 0.4 damage 15.4 angle 60 bkb 65 kbg 75 shield_damage 50 hitlag 80 angle_type forward }
        hitbox { start 101 end 160 x 0.5 y 0.29999 radius 0.4 damage 11 angle 55 bkb 60 kbg 75 shield_damage 50 hitlag 80 angle_type forward }
        hitbox {
            start 161
