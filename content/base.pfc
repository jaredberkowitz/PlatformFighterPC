        motion { start 12 end 12 vx 0 vy 0.025 }
        motion { start 13 end 13 vx 0 vy 0.00624 }
        motion { start 14 end 53 vx 0.15 vy -0.75 }
    }
    move neutral_special {
        total_frames 8
        script {
            // Needle Storm, the wind-up (neutral special). With a full charge stored it throws at once (32 = ext4); with some stored it charges on
            // from there, otherwise from none, after the wind-up (frame 7; 31 = ext3). Special pressed again during the wind-up is kept (`quick`):
            // the charge throws on its first frame.
            var needles;
            var thrown;
            var t;
            var quick;
            if frame >= 1 && special_tap { quick = 1; }
            if frame == 1 && stored > 0 {
                needles = stored;
                store(0);
                if needles >= 6 { goto(32); }
            }
            if frame >= 6 { goto(31); }
        }
    }
    move side_special {
        total_frames 43
        landing_lag 10
        projectile {
            frame 12
            x 0.9
            y 1
            speed 0.5
            life 14
            end_damage 3
            hitbox { start 0 end 0 x 0 y 0 radius 0.5 damage 3 angle 368 bkb 0 kbg 100 fixed_kb 80 }
        }
    }
    move up_special {
        total_frames 93
        landing_lag 20
        helpless_after true
        grabs_ledge true
        hitbox { start 35 end 37 x 0 y 0.59999 radius 1.59999 damage 12 angle 55 bkb 50 kbg 112 }
        hitbox { start 54 end 55 x 0 y 1.2 radius 1.09999 damage 5 angle 45 bkb 0 kbg 100 group 1 fixed_kb 80 sdi 0 }
        script {
            // Vanish (up special): a small hop in the air (on the ground it stays put), the explosion where the fighter stands (frames 36-38), then 20 frames of teleport in the
            // direction the stick holds on frame 36 (straight up when it is near neutral), faster the further it is pushed (1.5 reference units a
            // frame plus up to 1 more); it reappears with a hit (frames 55-56) keeping 0.3 of the speed. Intangible from frame 14 (19 in the
            // air) to 54.
            var rise;
            var dx;
            var dy;
            var speed;
            if frame == 1 && grounded == 0 { rise = 0.15; }
            if frame == 13 && grounded { intangible(41); }
            if frame == 18 && grounded == 0 { intangible(36); }
            if frame < 35 {
                rise = max(rise - 0.024, -0.031);
                set_vel(0, rise);
            }
            if frame == 35 {
                let len = sqrt(stick_x * stick_x + stick_y * stick_y);
                if len < 0.3 {
                    dx = 0;
                    dy = 1;
                    speed = 0.1875;
                } else {
                    dx = stick_x / len;
                    dy = stick_y / len;
                    speed = 0.1875 + 0.125 * min(len, 1);
                }
            }
            if frame >= 35 && frame < 55 { set_vel(dx * speed, dy * speed); }
            if frame == 55 { set_vel(dx * speed * 0.3, dy * speed * 0.3); }
        }
    }
    move down_special {
        total_frames 49
        landing_lag 36
        grabs_ledge true
        hitbox { start 22 end 28 x 0.7 y 0.29999 radius 0.4 damage 11 angle 361 bkb 26 kbg 97 hitlag 170 }
        hitbox { start 22 end 28 x 0.09999 y 0.59999 radius 0.4 damage 11 angle 361 bkb 26 kbg 97 priority 1 hitlag 170 }
        script {
            // Bouncing Fish (down special): a flip forward into a heel kick coming down (frames 23-29). It leaves at 1.6 reference units a frame
            // forward (1.5 in the air) and 3 up and falls at 1.5 times the rogue's gravity; from frame 30 the stick steers it (0 to 2.4 forward).
            // A hit bounces it back off the target (33 = ext5). Pressing special again before frame 16 kicks early: on frame 16 it carries on as
            // the early kick (34 = ext6), whose kick lands on frames 18-24 instead.
            var sx;
            var sy;
            var early;
            if frame >= 1 && frame <= 15 && special_tap { early = 1; }
            if early && frame >= 15 { goto(34); }
            if frame == 1 {
                sy = 0.375;
                if grounded { sx = 0.2; } else { sx = 0.1875; }
            }
            if hit { goto(33); }
            sy = max(sy - 0.028, -0.28);
            if frame >= 29 { sx = clamp(sx + stick_x * 0.025, 0, 0.3); }
            set_vel(sx, sy);
        }
    }
    move jab2 {
        total_frames 16
        hitbox { start 2 end 2 x 0.5 y 0.9 radius 0.2 damage 1.59999 angle 361 bkb 35 kbg 25 hitlag 120 }
        hitbox { start 2 end 2 x 0.9 y 1 radius 0.29999 damage 1.59999 angle 361 bkb 35 kbg 25 priority 1 hitlag 120 }
        hitbox { start 2 end 2 x 1.4 y 1 radius 0.29999 damage 1.59999 angle 361 bkb 25 kbg 20 priority 2 hitlag 120 }
        script {
            // Needles jab 2 (slot 17). The rapid jab (29 = ext1) follows as early as frame 5 once attack has been pressed twice since jab 1's
            // hit (the reference counts three, but presses during hitlag reach no script, and a jab's hitlag is long), or if attack is held as
            // the hit lands. (The variables are jab 1's: `taps` carries on counting.)
            var queued;
            var taps;
            if frame == 1 { queued = 0; }
            if attack_tap { taps = taps + 1; }
            if taps >= 2 { queued = 1; }
            if hit && attack && frame == 4 { queued = 1; }
            if queued && frame >= 4 { goto(29); }
        }
    }
    move grab {
        total_frames 35
        hitbox { start 5 end 6 x 1.59999 y 1.09999 radius 1 damage 0 angle 361 bkb 0 kbg 0 kind grab }
    }
    move dash_grab {
        total_frames 43
        hitbox { start 8 end 9 x 1.79999 y 1.09999 radius 1 damage 0 angle 361 bkb 0 kbg 0 kind grab }
    }
    move pummel {
        total_frames 14
        hitbox { start 1 end 1 x 0.59999 y 1 radius 0.59999 damage 1 angle 361 bkb 0 kbg 100 kind pummel hitlag 170 }
    }
    move fthrow {
        total_frames 38
        hitbox { start 19 end 19 x 1.29999 y 1.09999 radius 1 damage 5 angle 361 bkb 0 kbg 0 kind pummel }
        hitbox { start 21 end 21 x 1.29999 y 1.09999 radius 1 damage 2 angle 72 bkb 80 kbg 79 group 1 kind throw }
    }
    move bthrow {
        total_frames 34
        hitbox { start 14 end 14 x 1.29999 y 1.09999 radius 1 damage 5 angle 361 bkb 0 kbg 0 kind pummel }
        hitbox { start 16 end 16 x -1.29999 y 1.09999 radius 1 damage 2 angle 60 bkb 90 kbg 50 group 1 kind throw }
    }
    move uthrow {
        total_frames 48
        hitbox { start 18 end 18 x 1.29999 y 1.09999 radius 1 damage 3 angle 361 bkb 0 kbg 0 kind pummel }
        hitbox { start 20 end 20 x 1.29999 y 1.09999 radius 1 damage 3 angle 85 bkb 110 kbg 62 group 1 kind throw }
    }
    move dthrow {
        total_frames 52
        hitbox { start 25 end 25 x 1.29999 y 1.09999 radius 1 damage 3 angle 361 bkb 0 kbg 0 kind pummel }
        hitbox { start 29 end 29 x 1.29999 y 1.09999 radius 1 damage 3 angle 77 bkb 95 kbg 60 group 1 kind throw }
    }
    move ledge_attack {
        total_frames 54
        intangible 26
        hitbox { start 23 end 25 x 2.09999 y 0.59999 radius 1 damage 9 angle 45 bkb 90 kbg 20 }
        hitbox { start 23 end 25 x 1.2 y 0.59999 radius 1 damage 9 angle 45 bkb 90 kbg 20 }
    }
    move get_up_attack {
        total_frames 44
        intangible 22
        hitbox { start 15 end 16 x 1.79999 y 0.5 radius 0.9 damage 7 angle 361 bkb 80 kbg 48 }
        hitbox { start 20 end 21 x -1.79999 y 0.5 radius 0.9 damage 7 angle 361 bkb 80 kbg 48 group 1 }
    }
    move ext0 {
        total_frames 21
        hitbox { start 0 end 1 x 0 y 0.79999 radius 0.79999 damage 2 angle 48 bkb 77 kbg 50 }
    }
    move ext1 {
        total_frames 14
        rehit_start 4
        rehit_every 2
        hitbox { start 4 end 12 x 0.79999 y 1.09999 radius 0.29999 damage 0.29999 angle 361 bkb 12 kbg 15 hitlag 50 hitstun_add 2 sdi 40 }
        hitbox { start 4 end 12 x 1.2 y 1 radius 0.59999 damage 0.29999 angle 361 bkb 12 kbg 15 priority 1 hitlag 50 hitstun_add 2 sdi 40 }
        script {
            // Needles rapid jab (ext1, slot 29): one loop of quick stabs. At its end it loops again while attack is held or was pressed in
            // the last 10 frames; otherwise it ends in the finisher (30 = ext2).
            var queued;
            var taps;
            var since;
            since = since + 1;
            if attack || attack_tap { since = 0; }
            if frame >= 13 {
                if since < 10 { goto(29); } else { goto(30); }
            }
        }
    }
    move ext2 {
        total_frames 34
        hitbox { start 4 end 5 x 0.59999 y 1 radius 0.4 damage 2 angle 40 bkb 60 kbg 132 hitlag 200 }
        hitbox { start 4 end 5 x 0.9 y 1.2 radius 0.4 damage 2 angle 40 bkb 60 kbg 132 priority 1 hitlag 200 }
        hitbox { start 4 end 5 x 1.2 y 1.4 radius 0.4 damage 2 angle 40 bkb 60 kbg 132 priority 2 hitlag 200 }
    }
    move ext3 {
        total_frames 16
        landing_move ext3
        script {
            // Needle Storm, charging (ext3, slot 31), as the reference: the charge carries on by itself, a needle on the first frame (the
            // reference's frame 8) and one more every 15 frames, six at most. Pressing special again throws them (32 = ext4); shield (and so a
            // spot dodge or roll) or jump stores them for later and ends the move; a full charge stores itself 4 frames after the sixth needle.
            // Landing carries the charge on (the move is its own landing move). The move restarts itself every 15 frames to keep going.
            var needles;
            var thrown;
            var t;
            var quick;
            t = t + 1;
            if needles == 0 || (t >= 15 && needles < 6) {
                needles = needles + 1;
                t = 0;
            }
            if special_tap || quick {
                goto(32);
            } else if shield || jump || (needles >= 6 && t >= 4) {
                store(needles);
                end();
            } else if frame >= 15 {
                goto(31);
            }
        }
    }
    move ext4 {
        total_frames 47
        landing_lag 12
        projectile {
            frame 255
            x 1
            y 1.09999
            speed 1.25
            life 9
            end_damage 0.79999
            hitbox { start 0 end 0 x 0 y 0 radius 0.2 damage 1.5 angle 60 bkb 0 kbg 167 hitlag 80 }
        }
        script {
            // Needle Storm, the throw (ext4, slot 32): the charged needles, one every 3 frames from frame 11; straight ahead on the ground
            // (1.25 units a frame), 35 degrees down from the air. In the air the move ends at frame 43 instead of 49.
            var needles;
            var thrown;
            if thrown < needles && frame == 10 + 3 * thrown {
                thrown = thrown + 1;
                if grounded { spawn(1.0, 1.1, 1.25, 0); } else { spawn(1.25, 0.88, 1.02, -0.72); }
            }
            if grounded == 0 && frame >= 41 { end(); }
        }
    }
    move ext5 {
        total_frames 78
        landing_lag 20
        grabs_ledge true
        script {
            // Bouncing Fish, the bounce off a target (ext5, slot 33): back 1.8 reference units a frame and up 3.5, still falling at 1.5 times
            // gravity.
            var sx;
            var sy;
            if frame == 1 {
                sx = -0.225;
                sy = 0.4375;
            }
            sy = max(sy - 0.028, -0.28);
            set_vel(sx, sy);
        }
    }
    move ext6 {
        total_frames 29
        landing_lag 36
        grabs_ledge true
        hitbox { start 2 end 8 x 0.7 y 0.29999 radius 0.4 damage 11 angle 361 bkb 26 kbg 97 hitlag 170 }
        hitbox { start 2 end 8 x 0.09999 y 0.59999 radius 0.4 damage 11 angle 361 bkb 26 kbg 97 priority 1 hitlag 170 }
        script {
            // Bouncing Fish, the early kick (ext6, slot 34), entered on the fish's frame 16: the same flight carried on (its speeds are the
            // fish's variables), the kick on its frames 3-9 (the fish's 18-24). The stick steers from the fish's frame 30 (this move's 15).
            var sx;
            var sy;
            if hit { goto(33); }
            sy = max(sy - 0.028, -0.28);
            if frame >= 14 { sx = clamp(sx + stick_x * 0.025, 0, 0.3); }
            set_vel(sx, sy);
        }
    }
    move pivot_grab {
        total_frames 38
        hitbox { start 10 end 11 x 1.59999 y 1.09999 radius 1 damage 0 angle 361 bkb 0 kbg 0 kind grab }
    }
}

