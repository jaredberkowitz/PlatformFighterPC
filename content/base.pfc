        }
    }
    move ext5 {
        total_frames 44
        land_continue true
        projectile {
            frame 255
            x 1
            y 1.09999
            speed 0.3875
            life 167
            end_damage 9.59999
            bounce_max 4
            kind 1
            limit 1
            catch_from 60
            catch_move ext7
            bounces 255
            hitbox { start 0 end 0 x 0 y 0 radius 0.5 damage 9.59999 angle 70 bkb 80 kbg 40 shield_damage 58 angle_type travel }
            phase {
                from 10
                hitbox { start 0 end 0 x 0 y 0 radius 0.5 damage 7.2 angle 65 bkb 60 kbg 40 shield_damage 58 angle_type travel }
            }
            phase {
                from 60
                hitbox { start 0 end 0 x 0 y 0 radius 0.5 damage 3 angle 70 bkb 50 kbg 40 shield_damage 50 angle_type travel }
            }
            on_clank { life 60 vx -0.01874 vy 0.15625 gravity 0.01125 max_fall 0.17499 }
        }
        script {
            // Buckler side special, the smash-input throw (ext5): as the tilt throw, at 3.1 (0.3875 a frame). With its boomerang already out
            // (`owned`) it goes on as the failed throw (34 = ext6) on its frame 2.
            if frame == 1 && owned > 0 { goto(34); }
            if frame == 26 {
                let a = 0;
                if abs(stick_y) > 0.1 { a = 26 * stick_y; }
                spawn(1.0, 1.1, 0.3875 * cos(a), 0.3875 * sin(a));
            }
        }
        projectile_script {
            // The smash-input boomerang's flight: as the tilt one's (`buckler_boomerang_flight.script`), but the turn back speeds it up by 0.0232
            // a frame, the rate that takes it from 0.3 to 3 over the reference's 24 [E: gap 6, the reading].
            var back;
            let s = sqrt(pvx * pvx + pvy * pvy);
            if back == 0 && s > 0 {
                let ns = max(s - 0.005875, 0.0375);
                if ns <= 0.0375 { back = 1; }
                set_vel(pvx * ns / s, pvy * ns / s);
            } else if s > 0 {
                let tx = owner_x - px;
                let ty = owner_y + 1.1 - py;
                let d = sqrt(tx * tx + ty * ty);
                if d > 0.01 {
                    tx = tx / d;
                    ty = ty / d;
                    let ux = pvx / s;
                    let uy = pvy / s;
                    if back == 1 || ux * tx + uy * ty >= cos(0.75) {
                        back = 2;
                        ux = tx;
                        uy = ty;
                    } else {
                        let k = 0.75;
                        if ux * ty - uy * tx < 0 { k = -0.75; }
                        d = ux * cos(k) - uy * sin(k);
                        uy = ux * sin(k) + uy * cos(k);
                        ux = d;
                    }
                    d = min(s + 0.0232, 0.375);
                    set_vel(ux * d, uy * d);
                }
            }
        }
    }
    move ext6 {
        total_frames 57
        land_continue true
        script {
            // Buckler side special with its boomerang out (ext6, the failed throw): FAF 60 on the ground (the move's own data), 46 in the air:
            // started on the throw's frame 2, in the air it ends on its own frame 43 [D].
            if grounded == 0 && frame >= 43 { end(); }
        }
    }
    move ext7 { total_frames 8 land_continue true }
    move ext8 {
        total_frames 37
        land_continue true
        script {
            // Buckler bomb detonation (ext8): frames only (a move with neither hits nor a shot needs a script to be valid content, and this one
            // does nothing). The down special's own script calls detonate() on its frame 1 and goes on as this move, so the bomb bursts 12 frames
            // after the press (its blast's delay, 11, from that frame), on the press's frames 12-13 [R].
            if frame < 0 {
                end();
            }
        }
    }
    move ext9 {
        total_frames 28
        land_continue true
        keep_charge true
        spend_item 1
        projectile {
