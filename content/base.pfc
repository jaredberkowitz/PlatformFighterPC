        hitbox { start 9 end 10 x 1.2 y 0.79999 radius 0.4 damage 0 angle 361 bkb 0 kbg 0 kind grab }
        hitbox { start 9 end 10 x 1.79999 y 0.79999 radius 0.4 damage 0 angle 361 bkb 0 kbg 0 kind grab }
    }
}

