    move neutral_special {
        total_frames 66
        land_continue true
        start_speed 60
        projectile {
            frame 255
            x 1
            y 1.29999
            speed 0.75
            life 25
            end_damage 3.5
            hitbox { start 0 end 0 x 0 y 0 radius 0.29999 damage 3.5 angle 361 bkb 40 kbg 41 shield_damage 51 angle_type forward }
        }
        script {
            // Staff neutral special (the reticle): on frames 6-13 (the reference's 7-14) it looks for a target in front, within 15 world units
            // (120 reference units) chest to chest, with nothing solid in the way; the lock stays where the target's chest was. With a lock,
            // three shots on frames 22, 28 and 34 (the reference's 23, 29, 35) from the staff (1.0 ahead, 1.3 up [E]) straight at that point at
            // 0.75 world units a frame (6 reference units); without one, nothing.
            if frame >= 6 && frame <= 13 { lock(15); }
            if locked && (frame == 22 || frame == 28 || frame == 34) {
                let mx = x + facing;
                let my = y + 1.3;
                let dx = lock_x - mx;
                let dy = lock_y - my;
                let len = sqrt(dx * dx + dy * dy);
                if len > 0.01 {
                    spawn_at(mx, my, dx * facing / len * 0.75, dy / len * 0.75);
                }
            }
        }
    }
    move side_special {
        total_frames 70
        land_continue true
        start_speed 80
        projectile {
            frame 255
            x 5.59999
            y 1.29999
            speed 0
            life 31
            end_damage 1.5
            pocket never
            pierce true
            rehit 5
            hitbox { start 0 end 0 x 0 y 0 radius 0.59999 damage 1.5 angle 160 bkb 50 kbg 100 shield_damage 53 sdi 40 clanks false angle_type position }
            phase {
                from 5
                hitbox { start 0 end 0 x 0 y 0 radius 0.79999 damage 1.5 angle 160 bkb 50 kbg 100 shield_damage 53 sdi 40 clanks false angle_type position }
            }
            phase {
                from 9
                hitbox { start 0 end 0 x 0 y 0 radius 0.9 damage 1.5 angle 160 bkb 50 kbg 100 shield_damage 53 sdi 40 clanks false angle_type position }
            }
            phase {
