weapon staff {
    move jab {
        total_frames 23
        hitbox { start 7 end 8 x 0.59999 y 1.09999 radius 0.29999 damage 3 angle 361 bkb 25 kbg 20 hitlag 160 hitstun_add 4 angle_type forward }
        hitbox { start 7 end 8 x 1 y 1.09999 radius 0.29999 damage 3 angle 361 bkb 25 kbg 20 priority 1 hitlag 160 hitstun_add 4 angle_type forward }
        hitbox { start 7 end 8 x 1.5 y 1.09999 radius 0.29999 damage 3 angle 180 bkb 20 kbg 20 priority 2 hitlag 160 hitstun_add 4 angle_type forward }
        script {
            // Staff jab 1 (slot 0). There is no jab 2: on frames 10-24 it goes on into the rapid jab (39 = ext10) once attack has been pressed
            // and let go at least twice since jab 1 began (`presses` counts the press that started it, and presses during hitlag too); or on
            // frame 13 when attack is held and jab 1 has hit.
            if frame >= 9 && frame <= 23 && presses >= 2 && releases >= 2 { goto(39); }
            if frame == 12 && hit && attack { goto(39); }
        }
    }
