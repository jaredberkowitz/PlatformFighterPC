    move neutral_special {
        total_frames 66
        land_continue true
        start_speed 60
        projectile {
            frame 255
            x 1
            y 1.29999
            speed 0.75
            life 25
            end_damage 3.5
            hitbox { start 0 end 0 x 0 y 0 radius 0.29999 damage 3.5 angle 361 bkb 40 kbg 41 shield_damage 51 angle_type forward }
        }
        script {
            // Staff neutral special (the reticle): on frames 6-13 (the reference's 7-14) it looks for a target in front, within 15 world units
            // (120 reference units) chest to chest, with nothing solid in the way; the lock stays where the target's chest was. With a lock,
            // three shots on frames 22, 28 and 34 (the reference's 23, 29, 35) from the staff (1.0 ahead, 1.3 up [E]) straight at that point at
            // 0.75 world units a frame (6 reference units); without one, nothing.
            if frame >= 6 && frame <= 13 { lock(15); }
            if locked && (frame == 22 || frame == 28 || frame == 34) {
                let mx = x + facing;
                let my = y + 1.3;
                let dx = lock_x - mx;
                let dy = lock_y - my;
                let len = sqrt(dx * dx + dy * dy);
                if len > 0.01 {
                    spawn_at(mx, my, dx * facing / len * 0.75, dy / len * 0.75);
                }
            }
        }
    }
    move side_special {
        total_frames 70
        land_continue true
        start_speed 80
        projectile {
            frame 255
            x 5.59999
            y 1.29999
            speed 0
            life 31
            end_damage 1.5
            pierce true
            rehit 5
            hitbox { start 0 end 0 x 0 y 0 radius 0.59999 damage 1.5 angle 160 bkb 50 kbg 100 shield_damage 53 sdi 40 clanks false angle_type position }
            phase {
                from 5
                hitbox { start 0 end 0 x 0 y 0 radius 0.79999 damage 1.5 angle 160 bkb 50 kbg 100 shield_damage 53 sdi 40 clanks false angle_type position }
            }
            phase {
                from 9
                hitbox { start 0 end 0 x 0 y 0 radius 0.9 damage 1.5 angle 160 bkb 50 kbg 100 shield_damage 53 sdi 40 clanks false angle_type position }
            }
            phase {
                from 13
                hitbox { start 0 end 0 x 0 y 0 radius 1.09999 damage 1.5 angle 160 bkb 50 kbg 100 shield_damage 53 sdi 40 clanks false angle_type position }
            }
            phase {
                from 17
                hitbox { start 0 end 0 x 0 y 0 radius 1.2 damage 1.5 angle 160 bkb 50 kbg 100 shield_damage 53 sdi 40 clanks false angle_type position }
            }
            phase {
                from 21
                hitbox { start 0 end 0 x 0 y 0 radius 1.4 damage 1.5 angle 160 bkb 50 kbg 100 shield_damage 53 sdi 40 clanks false angle_type position }
            }
            phase {
                from 25
                hitbox { start 0 end 0 x 0 y 0 radius 1.5 damage 1.5 angle 160 bkb 50 kbg 100 shield_damage 53 sdi 40 clanks false angle_type position }
            }
            phase {
                from 29
                hitbox { start 0 end 0 x 0 y 0 radius 0 damage 1.5 angle 160 bkb 50 kbg 100 shield_damage 53 sdi 40 clanks false angle_type position }
            }
            phase {
                from 30
                hitbox {
                    start 0
                    end 0
                    x 0
                    y 0
                    radius 1.9
                    damage 5.5
                    angle 84
                    bkb 60
                    kbg 141
                    group 1
                    shield_damage 51
                    hitlag 150
                    sdi 40
                    clanks false
                    angle_type forward
                }
            }
        }
        script {
            // Staff side special (the explosive flame): the point is fixed where the fighter stood as the move began (read on its first
            // script frame, the position after frame 0), 5.625 world units ahead (9.375 when the special was input like a smash attack) and
            // 1.25 up; on frame 26 (the reference's 27) the explosion is made there, wherever the fighter has gone since.
            var x0;
            var y0;
            if frame == 1 {
                x0 = x;
                y0 = y;
            }
            if frame == 26 {
                let ahead = 5.625;
                if flick { ahead = 9.375; }
                spawn_at(x0 + ahead * facing, y0 + 1.25, 0, 0);
            }
        }
    }
    move up_special {
        total_frames 66
        landing_lag 22
        intangible 32
        helpless_after true
        ledge_front_from 32
        ledge_back_from 32
        fall_landing_lag 22
        intangible_from 15
        lands_from 32
        air { from 0 to 14 gravity 0.00374 max_fall 0.09375 }
        script {
            // Staff up special (the warp): on frame 15 (the reference's 16) the stick picks the direction (straight up when it is near neutral;
            // how far it is pushed does not matter), then 17 frames of travel at 3.5 reference units a frame (0.4375 world units) along it, and
            // on frame 32 (the reference's 33, the reappearance) half that speed once, after which the move's own air physics (or the ground's
            // friction) take over. The intangibility (16-32) is the move's data.
            var dx;
            var dy;
            if frame == 15 {
                let len = sqrt(stick_x * stick_x + stick_y * stick_y);
                if len < 0.2 {
                    dx = 0;
                    dy = 1;
                } else {
                    dx = stick_x / len;
                    dy = stick_y / len;
                }
            }
            if frame >= 15 && frame <= 31 { set_vel(dx * 0.4375, dy * 0.4375); }
            if frame == 32 { set_vel(dx * 0.21875, dy * 0.21875); }
        }
    }
