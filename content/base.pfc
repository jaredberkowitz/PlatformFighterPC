    move ext1 {
        total_frames 36
        hitbox { start 4 end 5 x 2.34395 y 1.09999 radius 0.7 damage 3 angle 361 bkb 25 kbg 0 priority 2 }
        hitbox { start 4 end 5 x 1.40796 y 1.09999 radius 0.79999 damage 2.5 angle 361 bkb 25 kbg 0 }
        script {
            // Dancing Blade, hit 2 (ext1 or ext2): a short step forward. Press special again to continue into hit 3: stick up
            // for the rising slash (32 = ext4), down for the low one (33 = ext5), otherwise straight (31 = ext3).
            var queued;
            var dir;
            if grounded && frame <= 3 { set_vel(0.14, 0); }
            if grounded && frame == 4 { set_vel(0, 0); }
            if special_tap && frame >= 3 {
                queued = 1;
                dir = 0;
                if stick_y > 0.5 { dir = 1; }
                if stick_y < -0.5 { dir = -1; }
            }
            if queued && frame >= 17 {
                queued = 0;
                if dir == 1 { goto(32); } else if dir == -1 { goto(33); } else { goto(31); }
            }
        }
    }
    move ext2 {
        total_frames 36
        hitbox { start 3 end 4 x 1.83997 y 1.89197 radius 0.7 damage 3 angle 80 bkb 25 kbg 0 priority 2 }
        hitbox { start 3 end 4 x 1.11998 y 1.53198 radius 0.79999 damage 2.5 angle 80 bkb 25 kbg 0 }
        script {
            // Dancing Blade, hit 2 (ext1 or ext2): a short step forward. Press special again to continue into hit 3: stick up
            // for the rising slash (32 = ext4), down for the low one (33 = ext5), otherwise straight (31 = ext3).
            var queued;
            var dir;
            if grounded && frame <= 3 { set_vel(0.14, 0); }
            if grounded && frame == 4 { set_vel(0, 0); }
            if special_tap && frame >= 3 {
                queued = 1;
                dir = 0;
                if stick_y > 0.5 { dir = 1; }
                if stick_y < -0.5 { dir = -1; }
            }
            if queued && frame >= 17 {
                queued = 0;
                if dir == 1 { goto(32); } else if dir == -1 { goto(33); } else { goto(31); }
            }
        }
    }
    move ext3 {
        total_frames 41
        hitbox { start 3 end 4 x 2.34395 y 1.09999 radius 0.7 damage 4 angle 361 bkb 25 kbg 0 priority 2 }
        hitbox { start 3 end 4 x 1.40796 y 1.09999 radius 0.79999 damage 3 angle 361 bkb 25 kbg 0 }
        script {
            // Dancing Blade, hit 3 (ext3, ext4 or ext5): a short step forward. Press special again for the finisher: stick up
            // for the rising one (35 = ext7), down for the low multi-hit one (36 = ext8), otherwise straight (34 = ext6).
            var queued;
            var dir;
            if grounded && frame <= 3 { set_vel(0.14, 0); }
            if grounded && frame == 4 { set_vel(0, 0); }
